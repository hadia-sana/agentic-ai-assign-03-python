nums = [1, 2, 3, 4, 5, 6, 7, 8, 9]
even_nums = []
for n in nums:
    if n % 2 == 0:
        even_nums.append(n)
print("Even numbers:", even_nums)

squares = []
for i in range(1, 11):
    squares.append(i ** 2)
print("Squares of first 10 natural numbers:", squares)

