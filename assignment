# Chapter 3
fruits = ["apple", "banana", "mango", "orange", "grapes"]
print(fruits[0])
print(fruits[1])
print(fruits[2])
print(fruits[3])
print(fruits[4])

fruits[1] = "kiwi"
print(f"Updated list: {fruits}")

fruits.append("pineapple")
fruits.insert(0, "cherry")
print(f"After adding fruits: {fruits}")

del fruits[2]
print(f"After del: {fruits}")

popped_fruit = fruits.pop()
print(f"Popped: {popped_fruit}")
print(f"After pop: {fruits}")

fruits.remove("apple")
print(f"After remove: {fruits}")

print("Temporary sort:", sorted(fruits))
print("Original list:", fruits)

fruits.sort()
print("Permanently sorted list:", fruits)

destinations = ["Japan", "Norway", "Turkey", "Canada", "New Zealand"]
destinations.sort()
print("Sorted alphabetically:", destinations)

destinations.reverse()
print("Reversed order:", destinations)

print("Total destinations:", len(destinations))

